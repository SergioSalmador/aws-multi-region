digraph NetworkingArchitecture {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fontname="Helvetica", fillcolor="white"];
  edge [fontname="Helvetica", color="#555555"];

  subgraph cluster_dev {
    label="DEV Networking";
    color="#59A14F";
    style="rounded";

    dev_ir_vpc [label="Ireland VPC\n10.10.0.0/16", fillcolor="#EEF8EC"];
    dev_ir_pub [label="Public Subnets\n10.10.0.0/24\n10.10.1.0/24\n10.10.2.0/24", fillcolor="#F5FBF4"];
    dev_ir_pri [label="Private Subnets\n10.10.10.0/24\n10.10.11.0/24\n10.10.12.0/24", fillcolor="#F5FBF4"];
    dev_ir_vpn [label="Client VPN\n172.16.0.0/22", fillcolor="#DCF3D8"];

    dev_es_vpc [label="Spain VPC\n10.11.0.0/16", fillcolor="#EEF8EC"];
    dev_es_pub [label="Public Subnets\n10.11.0.0/24\n10.11.1.0/24\n10.11.2.0/24", fillcolor="#F5FBF4"];
    dev_es_pri [label="Private Subnets\n10.11.10.0/24\n10.11.11.0/24\n10.11.12.0/24", fillcolor="#F5FBF4"];
    dev_es_vpn [label="Client VPN\n172.16.4.0/22", fillcolor="#DCF3D8"];

    dev_ir_vpc -> dev_ir_pub;
    dev_ir_vpc -> dev_ir_pri;
    dev_ir_vpn -> dev_ir_pri [label="private access"];

    dev_es_vpc -> dev_es_pub;
    dev_es_vpc -> dev_es_pri;
    dev_es_vpn -> dev_es_pri [label="private access"];
  }

  subgraph cluster_prod {
    label="PROD Networking";
    color="#E15759";
    style="rounded";

    prod_ir_vpc [label="Ireland VPC\n10.20.0.0/16", fillcolor="#FDEDEE"];
    prod_ir_pub [label="Public Subnets\n10.20.0.0/24\n10.20.1.0/24\n10.20.2.0/24", fillcolor="#FFF5F5"];
    prod_ir_pri [label="Private Subnets\n10.20.10.0/24\n10.20.11.0/24\n10.20.12.0/24", fillcolor="#FFF5F5"];
    prod_ir_vpn [label="Client VPN\n172.17.0.0/22", fillcolor="#FBDCDD"];

    prod_es_vpc [label="Spain VPC\n10.21.0.0/16", fillcolor="#FDEDEE"];
    prod_es_pub [label="Public Subnets\n10.21.0.0/24\n10.21.1.0/24\n10.21.2.0/24", fillcolor="#FFF5F5"];
    prod_es_pri [label="Private Subnets\n10.21.10.0/24\n10.21.11.0/24\n10.21.12.0/24", fillcolor="#FFF5F5"];
    prod_es_vpn [label="Client VPN\n172.17.4.0/22", fillcolor="#FBDCDD"];

    prod_ir_vpc -> prod_ir_pub;
    prod_ir_vpc -> prod_ir_pri;
    prod_ir_vpn -> prod_ir_pri [label="private access"];

    prod_es_vpc -> prod_es_pub;
    prod_es_vpc -> prod_es_pri;
    prod_es_vpn -> prod_es_pri [label="private access"];
  }
}
